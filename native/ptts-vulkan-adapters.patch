+#[cfg(all(not(target_vendor = "apple"), feature = "vulkan-adapters"))]
+#[unsafe(no_mangle)]
+pub extern "C" fn ptts_vulkan_adapters(
+    visit: extern "C" fn(*const u8, *const c_char, *mut c_void), user: *mut c_void,
+) -> bool {
+    match guarded(|| xn::vulkan_backend::Device::adapters().map_err(|e| e.to_string())) {
+        Ok(adapters) => {
+            for (id, name) in adapters {
+                visit(id.as_ptr(), c_string(&name).as_ptr(), user);
+            }
+            true
+        }
+        Err(error) => {
+            LAST_ERROR.with(|slot| *slot.borrow_mut() = Some(c_string(&error)));
+            false
+        }
+    }
+}
+
+/// Load on the automatic GPU or the adapter identified by a 16-byte UUID.
+///
+/// # Safety
+/// `dir` and `lang` must be NUL-terminated UTF-8; `id` is null or readable for 16 bytes.
+#[cfg(all(not(target_vendor = "apple"), feature = "vulkan-adapters"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_new_vulkan(
+    dir: *const c_char, lang: *const c_char, id: *const [u8; 16],
+) -> *mut PttsHandle {
+    let dir = unsafe { CStr::from_ptr(dir) }.to_string_lossy();
+    let lang = unsafe { CStr::from_ptr(lang) }.to_string_lossy();
+    let id = unsafe { id.as_ref() }.copied();
+    match guarded(|| Engine::open_selected(Path::new(dir.as_ref()), PTTS_UNIT_VULKAN, &lang, id)) {
+        Ok(engine) => Box::into_raw(Box::new(handle(engine))),
+        Err(error) => {
+            LAST_ERROR.with(|slot| *slot.borrow_mut() = Some(c_string(&error)));
+            std::ptr::null_mut()
+        }
+    }
+}
+
+/// Return the selected Vulkan adapter name, borrowed for the lifetime of `h`.
+///
+/// # Safety
+/// `h` must be null or come from `ptts_new` or `ptts_new_vulkan`.
+#[cfg(all(not(target_vendor = "apple"), feature = "vulkan-adapters"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_vulkan_name(h: *const PttsHandle) -> *const c_char {
+    unsafe { h.as_ref() }.and_then(|h| h.engine.gpu_name.as_ref())
+        .map_or(std::ptr::null(), |name| name.as_ptr())
+}

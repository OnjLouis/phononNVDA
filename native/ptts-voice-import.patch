+use safetensors::{Dtype, SafeTensors};
+use std::io::{self, Read};
+
+pub const MAX_VOICE_BYTES: usize = 4 * 1024 * 1024;
+const MAX_HEADER_BYTES: usize = 16 * 1024;
+const MAX_VOICE_FRAMES: usize = 512;
+
+pub struct Checkpoint<'a> {
+    pub embedding_width: usize,
+    pub latent_width: Option<usize>,
+    pub compatible_model_tags: &'a [&'a str],
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum TensorKind {
+    Embedding,
+    Latents,
+}
+
+#[derive(Debug)]
+pub struct VoiceTensor {
+    pub kind: TensorKind,
+    pub frames: usize,
+    pub width: usize,
+    pub values: Vec<f32>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum InvalidVoice {
+    Size,
+    Format,
+    Tensor,
+    Checkpoint,
+    NonFinite,
+}
+
+/// Read at most one byte beyond the import limit even if the file changes while opened.
+pub fn read_bounded(input: impl Read) -> io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    input.take((MAX_VOICE_BYTES + 1) as u64).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_VOICE_BYTES {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "Phonon voice file is too large"));
+    }
+    Ok(bytes)
+}
+
+/// Validate for the destination checkpoint before registering anything or touching an engine.
+pub fn decode(bytes: &[u8], checkpoint: &Checkpoint<'_>) -> Result<VoiceTensor, InvalidVoice> {
+    if bytes.len() > MAX_VOICE_BYTES {
+        return Err(InvalidVoice::Size);
+    }
+    let length = bytes.get(..8).ok_or(InvalidVoice::Format)?;
+    if u64::from_le_bytes(length.try_into().map_err(|_| InvalidVoice::Format)?) > MAX_HEADER_BYTES as u64 {
+        return Err(InvalidVoice::Size);
+    }
+    let (_, metadata) = SafeTensors::read_metadata(bytes).map_err(|_| InvalidVoice::Format)?;
+    if let Some(tag) = metadata.metadata().as_ref().and_then(|m| m.get("model_ext"))
+        && !checkpoint.compatible_model_tags.is_empty()
+        && !checkpoint.compatible_model_tags.contains(&tag.as_str())
+    {
+        return Err(InvalidVoice::Checkpoint);
+    }
+    let tensors = SafeTensors::deserialize(bytes).map_err(|_| InvalidVoice::Format)?;
+    let names = tensors.names();
+    let [name] = names.as_slice() else { return Err(InvalidVoice::Tensor) };
+    let kind = match *name {
+        "emb" | "audio_prompt" => TensorKind::Embedding,
+        "speaker_wavs" => TensorKind::Latents,
+        _ => return Err(InvalidVoice::Tensor),
+    };
+    let tensor = tensors.tensor(name).map_err(|_| InvalidVoice::Tensor)?;
+    if tensor.dtype() != Dtype::F32 {
+        return Err(InvalidVoice::Tensor);
+    }
+    let (outer, inner) = match tensor.shape() {
+        [outer, inner] | [1, outer, inner] => (*outer, *inner),
+        _ => return Err(InvalidVoice::Tensor),
+    };
+    let (frames, width, expected_width) = match kind {
+        TensorKind::Embedding => (outer, inner, checkpoint.embedding_width),
+        TensorKind::Latents => (inner, outer, checkpoint.latent_width.ok_or(InvalidVoice::Checkpoint)?),
+    };
+    if width == 0 || width != expected_width || !(1..=MAX_VOICE_FRAMES).contains(&frames) {
+        return Err(InvalidVoice::Checkpoint);
+    }
+    let values = tensor.data().chunks_exact(4).map(|raw| {
+        let value = f32::from_le_bytes(raw.try_into().expect("f32 chunk"));
+        value.is_finite().then_some(value).ok_or(InvalidVoice::NonFinite)
+    }).collect::<Result<Vec<_>, _>>()?;
+    Ok(VoiceTensor { kind, frames, width, values })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use safetensors::{serialize, tensor::TensorView};
+    use std::collections::HashMap;
+
+    const MODEL: Checkpoint<'_> = Checkpoint {
+        embedding_width: 512,
+        latent_width: Some(512),
+        compatible_model_tags: &["ba7a5a45@300"],
+    };
+
+    fn voice(name: &str, shape: Vec<usize>, dtype: Dtype, value: f32, tag: Option<&str>) -> Vec<u8> {
+        let data = value.to_le_bytes().repeat(shape.iter().product::<usize>() * dtype.bitsize() / 32);
+        let tensor = TensorView::new(dtype, shape, &data).unwrap();
+        serialize([(name, tensor)], tag.map(|tag| HashMap::from([("model_ext".to_owned(), tag.to_owned())]))).unwrap()
+    }
+
+    #[test]
+    fn accepts_projected_and_unprojected_layouts_without_reshaping_data() {
+        for (name, shape, kind) in [
+            ("emb", vec![1, 125, 512], TensorKind::Embedding),
+            ("audio_prompt", vec![125, 512], TensorKind::Embedding),
+            ("speaker_wavs", vec![1, 512, 125], TensorKind::Latents),
+        ] {
+            let input = voice(name, shape, Dtype::F32, 0.25, Some("ba7a5a45@300"));
+            let got = decode(&input, &MODEL).unwrap();
+            assert_eq!((got.kind, got.frames, got.width), (kind, 125, 512));
+            assert_eq!(got.values, vec![0.25; 125 * 512]);
+        }
+    }
+
+    #[test]
+    fn rejects_wrong_model_or_projection_and_invalid_dimensions() {
+        let wrong = voice("emb", vec![1, 125, 512], Dtype::F32, 0.25, Some("other-model"));
+        assert_eq!(decode(&wrong, &MODEL).unwrap_err(), InvalidVoice::Checkpoint);
+        for shape in [vec![1, 0, 512], vec![1, 513, 512], vec![125, 511]] {
+            let input = voice("emb", shape, Dtype::F32, 0.25, None);
+            assert_eq!(decode(&input, &MODEL).unwrap_err(), InvalidVoice::Checkpoint);
+        }
+        let latents = voice("speaker_wavs", vec![1, 512, 125], Dtype::F32, 0.25, None);
+        let no_projection = Checkpoint { latent_width: None, ..MODEL };
+        assert_eq!(decode(&latents, &no_projection).unwrap_err(), InvalidVoice::Checkpoint);
+    }
+
+    #[test]
+    fn rejects_wrong_tensor_type_name_shape_and_nonfinite_values() {
+        for (name, shape, dtype) in [
+            ("unrelated", vec![125, 512], Dtype::F32),
+            ("emb", vec![125, 512], Dtype::F16),
+            ("emb", vec![2, 125, 512], Dtype::F32),
+        ] {
+            let input = voice(name, shape, dtype, 0.25, None);
+            assert_eq!(decode(&input, &MODEL).unwrap_err(), InvalidVoice::Tensor);
+        }
+        for number in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+            let input = voice("emb", vec![1, 512], Dtype::F32, number, None);
+            assert_eq!(decode(&input, &MODEL).unwrap_err(), InvalidVoice::NonFinite);
+        }
+    }
+
+    #[test]
+    fn refuses_malformed_offsets_trailing_bytes_and_oversize_reads() {
+        let mut input = voice("emb", vec![1, 512], Dtype::F32, 0.25, None);
+        let length = input.len();
+        assert_eq!(decode(&input[..length - 1], &MODEL).unwrap_err(), InvalidVoice::Format);
+        input.push(0);
+        assert_eq!(decode(&input, &MODEL).unwrap_err(), InvalidVoice::Format);
+        assert_eq!(decode(&u64::MAX.to_le_bytes(), &MODEL).unwrap_err(), InvalidVoice::Size);
+        assert!(read_bounded(io::repeat(0)).is_err());
+        assert_eq!(read_bounded(&b"sample"[..]).unwrap(), b"sample");
+    }
+}

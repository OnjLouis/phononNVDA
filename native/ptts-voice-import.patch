+use crate::{guarded, c_string, LAST_ERROR, PttsHandle};
+use phonon_voice_import_validation::MAX_VOICE_BYTES;
+use std::{ffi::{c_char, CStr}, path::Path};
+
+/// Validate a voice against the bundled configuration without loading weights.
+///
+/// # Safety
+/// `directory` is a NUL-terminated UTF-8 string, and `data` points to `length`
+/// readable bytes. Failure is available from `ptts_last_error(NULL)`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_validate_imported_voice(
+    directory: *const c_char,
+    data: *const u8,
+    length: usize,
+) -> bool {
+    let result = guarded(|| {
+        if directory.is_null() || data.is_null() || length == 0 || length > MAX_VOICE_BYTES {
+            return Err("Invalid Phonon voice file size".into());
+        }
+        let directory = unsafe { CStr::from_ptr(directory) }.to_str().map_err(|e| e.to_string())?;
+        let config = ptts::checkpoint::read_config(&Path::new(directory).join("config.json"))
+            .map_err(|e| e.to_string())?;
+        crate::cpu::decode_import(&config, unsafe { std::slice::from_raw_parts(data, length) }).map(|_| ())
+    });
+    LAST_ERROR.with(|slot| *slot.borrow_mut() = result.as_ref().err().map(|e| c_string(e)));
+    result.is_ok()
+}
+
+/// Validate and select one custom voice on the same thread that owns this handle.
+/// The reserved slot is replaced rather than letting custom tensors accumulate.
+///
+/// # Safety
+/// `handle` must come from `ptts_new`. `data` must point to `length` readable bytes
+/// and the caller must not concurrently access `handle`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_set_imported_voice(
+    handle: *mut PttsHandle,
+    data: *const u8,
+    length: usize,
+) -> bool {
+    let Some(handle) = (unsafe { handle.as_mut() }) else { return false };
+    let result = guarded(|| {
+        if data.is_null() || length == 0 || length > MAX_VOICE_BYTES {
+            return Err("Invalid Phonon voice file size".into());
+        }
+        handle.engine.set_imported_voice(unsafe { std::slice::from_raw_parts(data, length) })
+    });
+    handle.last_error = result.as_ref().err().map(|error| c_string(error));
+    result.is_ok()
+}

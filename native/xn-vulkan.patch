+use super::MAX_BINDINGS;
+use ash::vk;
+
+// ash wrappers only hold dispatch tables. Until DeviceInner exists, this guard
+// owns the native objects; the entry in the caller keeps the loader alive.
+pub(super) struct DeviceRollback {
+    instance: ash::Instance,
+    pub(super) device: Option<ash::Device>,
+    pub(super) query_pool: vk::QueryPool,
+    pub(super) set_layouts: [vk::DescriptorSetLayout; MAX_BINDINGS + 1],
+    pub(super) pipeline_layouts: [vk::PipelineLayout; MAX_BINDINGS + 1],
+    pub(super) command_pool: vk::CommandPool,
+    pub(super) fence: vk::Fence,
+    pub(super) descriptor_pool: vk::DescriptorPool,
+    pub(super) armed: bool,
+}
+
+impl DeviceRollback {
+    pub(super) fn new(instance: &ash::Instance) -> Self {
+        Self {
+            instance: instance.clone(),
+            device: None,
+            query_pool: vk::QueryPool::null(),
+            set_layouts: [vk::DescriptorSetLayout::null(); MAX_BINDINGS + 1],
+            pipeline_layouts: [vk::PipelineLayout::null(); MAX_BINDINGS + 1],
+            command_pool: vk::CommandPool::null(),
+            fence: vk::Fence::null(),
+            descriptor_pool: vk::DescriptorPool::null(),
+            armed: true,
+        }
+    }
+}
+
+impl Drop for DeviceRollback {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        unsafe {
+            if let Some(device) = &self.device {
+                if self.descriptor_pool != vk::DescriptorPool::null() {
+                    device.destroy_descriptor_pool(self.descriptor_pool, None);
+                }
+                if self.fence != vk::Fence::null() {
+                    device.destroy_fence(self.fence, None);
+                }
+                if self.command_pool != vk::CommandPool::null() {
+                    // The pool also frees any successfully allocated command buffers.
+                    device.destroy_command_pool(self.command_pool, None);
+                }
+                for n in (1..=MAX_BINDINGS).rev() {
+                    if self.pipeline_layouts[n] != vk::PipelineLayout::null() {
+                        device.destroy_pipeline_layout(self.pipeline_layouts[n], None);
+                    }
+                    if self.set_layouts[n] != vk::DescriptorSetLayout::null() {
+                        device.destroy_descriptor_set_layout(self.set_layouts[n], None);
+                    }
+                }
+                if self.query_pool != vk::QueryPool::null() {
+                    device.destroy_query_pool(self.query_pool, None);
+                }
+                device.destroy_device(None);
+            }
+            self.instance.destroy_instance(None);
+        }
+    }
+}
+
+pub(super) struct BufferRollback<'a> {
+    pub(super) device: &'a ash::Device,
+    pub(super) buffer: vk::Buffer,
+    pub(super) memory: vk::DeviceMemory,
+    pub(super) armed: bool,
+}
+
+impl Drop for BufferRollback<'_> {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        unsafe {
+            // Memory must outlive the buffer once bound. Freeing memory also
+            // implicitly unmaps it if a later step fails after mapping.
+            self.device.destroy_buffer(self.buffer, None);
+            if self.memory != vk::DeviceMemory::null() {
+                self.device.free_memory(self.memory, None);
+            }
+        }
+    }
+}
+
+pub(super) struct PipelineRollback<'a> {
+    pub(super) device: &'a ash::Device,
+    pub(super) module: vk::ShaderModule,
+    pub(super) pipelines: Vec<vk::Pipeline>,
+    pub(super) armed: bool,
+}
+
+impl Drop for PipelineRollback<'_> {
+    fn drop(&mut self) {
+        if !self.armed {
+            return;
+        }
+        unsafe {
+            // Vulkan may return valid handles mixed with nulls on failure.
+            for &pipeline in self.pipelines.iter().rev() {
+                if pipeline != vk::Pipeline::null() {
+                    self.device.destroy_pipeline(pipeline, None);
+                }
+            }
+            self.device.destroy_shader_module(self.module, None);
+        }
+    }
+}

+use super::*;
+use ash::vk::Handle;
+use std::cell::RefCell;
+use std::ffi::{c_char, c_void};
+
+#[derive(Default)]
+struct Driver {
+    active: bool,
+    profile: bool,
+    fail_at: Option<usize>,
+    calls: usize,
+    next_handle: u64,
+    created: Vec<(&'static str, u64)>,
+    destroyed: Vec<(&'static str, u64)>,
+    no_devices: bool,
+    no_compute: bool,
+    no_memory: bool,
+    partial_pipeline: bool,
+}
+
+thread_local! {
+    static DRIVER: RefCell<Driver> = RefCell::new(Driver::default());
+}
+
+fn reset() {
+    DRIVER.with(|d| *d.borrow_mut() = Driver { active: true, ..Driver::default() });
+}
+
+struct MockScope;
+
+impl Drop for MockScope {
+    fn drop(&mut self) {
+        DRIVER.with(|d| *d.borrow_mut() = Driver::default());
+    }
+}
+
+pub(super) fn load_entry() -> std::result::Result<ash::Entry, ash::LoadingError> {
+    if !DRIVER.with(|d| d.borrow().active) {
+        return unsafe { ash::Entry::load() };
+    }
+    Ok(unsafe { ash::Entry::from_static_fn(ash::StaticFn { get_instance_proc_addr }) })
+}
+
+pub(super) fn profile_requested(requested: bool) -> bool {
+    DRIVER.with(|d| {
+        let d = d.borrow();
+        if d.active { d.profile } else { requested }
+    })
+}
+
+fn checkpoint() -> vk::Result {
+    DRIVER.with(|d| {
+        let mut d = d.borrow_mut();
+        d.calls += 1;
+        if d.fail_at == Some(d.calls) {
+            vk::Result::ERROR_OUT_OF_HOST_MEMORY
+        } else {
+            vk::Result::SUCCESS
+        }
+    })
+}
+
+fn created(kind: &'static str) -> u64 {
+    DRIVER.with(|d| {
+        let mut d = d.borrow_mut();
+        d.next_handle += 1;
+        let handle = d.next_handle;
+        d.created.push((kind, handle));
+        handle
+    })
+}
+
+fn destroyed(kind: &'static str, handle: u64) {
+    DRIVER.with(|d| d.borrow_mut().destroyed.push((kind, handle)));
+}
+
+fn assert_reverse_cleanup() {
+    DRIVER.with(|d| {
+        let d = d.borrow();
+        let expected: Vec<_> = d.created.iter().rev().copied().collect();
+        assert_eq!(d.destroyed, expected);
+    });
+}
+
+fn new_device(profile: bool) -> Result<Device> {
+    DRIVER.with(|d| d.borrow_mut().profile = profile);
+    Device::new(0)
+}
+
+#[test]
+fn constructor_rolls_back_every_allocation_checkpoint() {
+    let _mock = MockScope;
+    for profile in [false, true] {
+        reset();
+        let device = new_device(profile).unwrap();
+        let calls = DRIVER.with(|d| d.borrow().calls);
+        drop(device);
+        for fail_at in 1..=calls {
+            reset();
+            DRIVER.with(|d| d.borrow_mut().fail_at = Some(fail_at));
+            let result = new_device(profile);
+            assert!(result.is_err(), "checkpoint {fail_at}, profile {profile}");
+            assert_reverse_cleanup();
+        }
+    }
+}
+
+#[test]
+fn constructor_releases_instance_on_selection_errors() {
+    let _mock = MockScope;
+    for no_devices in [false, true] {
+        reset();
+        DRIVER.with(|d| {
+            let mut d = d.borrow_mut();
+            d.no_devices = no_devices;
+            d.no_compute = !no_devices;
+        });
+        assert!(new_device(false).is_err());
+        assert_reverse_cleanup();
+    }
+}
+
+#[test]
+fn successful_constructor_transfers_ownership_once() {
+    let _mock = MockScope;
+    for profile in [false, true] {
+        reset();
+        let device = new_device(profile).unwrap();
+        DRIVER.with(|d| assert!(d.borrow().destroyed.is_empty()));
+        let retained = device.clone();
+        drop(device);
+        DRIVER.with(|d| assert!(d.borrow().destroyed.is_empty()));
+        drop(retained);
+        DRIVER.with(|d| {
+            let d = d.borrow();
+            let mut expected = d.created.clone();
+            let mut actual = d.destroyed.clone();
+            expected.sort_unstable();
+            actual.sort_unstable();
+            assert_eq!(actual, expected);
+            assert_eq!(d.destroyed.last().unwrap().0, "instance");
+            assert_eq!(d.destroyed[d.destroyed.len() - 2].0, "device");
+        });
+    }
+}
+
+#[test]
+fn buffer_failures_release_only_new_resources_in_dependency_order() {
+    let _mock = MockScope;
+    for failure in 0..=4 {
+        reset();
+        let device = new_device(false).unwrap();
+        DRIVER.with(|d| {
+            let mut d = d.borrow_mut();
+            d.created.clear();
+            d.destroyed.clear();
+            d.calls = 0;
+            d.no_memory = failure == 0;
+            d.fail_at = Some(failure);
+        });
+        assert!(device.alloc_buffer(256).is_err(), "buffer failure {failure}");
+        DRIVER.with(|d| {
+            let d = d.borrow();
+            // Bound memory must outlive its buffer, not the other way round.
+            assert_eq!(d.destroyed, d.created);
+        });
+        drop(device);
+    }
+}
+
+#[test]
+fn successful_buffer_transfers_to_recycling_pool() {
+    let _mock = MockScope;
+    reset();
+    let device = new_device(false).unwrap();
+    let (buffer, memory, ptr, class) = device.alloc_buffer(256).unwrap();
+    DRIVER.with(|d| assert!(d.borrow().destroyed.is_empty()));
+    device.defer_free(PooledBuf { buffer, memory, ptr: ptr as usize, class });
+    drop(device);
+    DRIVER.with(|d| {
+        let d = d.borrow();
+        assert_eq!(d.destroyed.iter().filter(|e| e.0 == "buffer").count(), 1);
+        assert_eq!(d.destroyed.iter().filter(|e| e.0 == "memory").count(), 1);
+    });
+}
+
+#[test]
+fn pipeline_errors_destroy_shader_and_partial_non_null_pipelines() {
+    let _mock = MockScope;
+    for failure in 1..=3 {
+        reset();
+        let device = new_device(false).unwrap();
+        DRIVER.with(|d| {
+            let mut d = d.borrow_mut();
+            d.created.clear();
+            d.destroyed.clear();
+            d.calls = 0;
+            d.fail_at = Some(failure.min(2));
+            d.partial_pipeline = failure == 3;
+        });
+        assert!(device.get_pipeline("fill_f32").is_err());
+        assert!(device.pipelines.lock().unwrap().is_empty());
+        assert_reverse_cleanup();
+        // Failed entries must not poison the cache or prevent CPU/GPU retry.
+        DRIVER.with(|d| d.borrow_mut().fail_at = None);
+        assert!(device.get_pipeline("fill_f32").is_ok());
+        drop(device);
+    }
+}
+
+#[test]
+fn successful_pipeline_transfers_to_cache_once() {
+    let _mock = MockScope;
+    reset();
+    let device = new_device(false).unwrap();
+    let first = device.get_pipeline("fill_f32").unwrap();
+    let calls = DRIVER.with(|d| d.borrow().calls);
+    assert_eq!(device.get_pipeline("fill_f32").unwrap(), first);
+    DRIVER.with(|d| {
+        let d = d.borrow();
+        assert_eq!(d.calls, calls);
+        assert!(d.destroyed.is_empty());
+    });
+    drop(device);
+    DRIVER.with(|d| {
+        let d = d.borrow();
+        let cleanup: Vec<_> = d.destroyed.iter()
+            .filter(|e| e.0 == "pipeline" || e.0 == "shader").map(|e| e.0).collect();
+        assert_eq!(cleanup, ["pipeline", "shader"]);
+    });
+}
+
+// These typed Vulkan entry points exercise ash's real Result and partial-output
+// handling. No loader, GPU, environment mutation, or process-global hooks are used.
+macro_rules! create_device_resource {
+    ($name:ident, $info:ident, $handle:ident, $kind:literal) => {
+        unsafe extern "system" fn $name(
+            _: vk::Device, _: *const vk::$info<'_>,
+            _: *const vk::AllocationCallbacks<'_>, out: *mut vk::$handle,
+        ) -> vk::Result {
+            let result = checkpoint();
+            if result == vk::Result::SUCCESS {
+                unsafe { *out = vk::$handle::from_raw(created($kind)); }
+            }
+            result
+        }
+    };
+}
+
+macro_rules! destroy_device_resource {
+    ($name:ident, $handle:ident, $kind:literal) => {
+        unsafe extern "system" fn $name(
+            _: vk::Device, handle: vk::$handle, _: *const vk::AllocationCallbacks<'_>,
+        ) {
+            destroyed($kind, handle.as_raw());
+        }
+    };
+}
+
+create_device_resource!(create_query_pool, QueryPoolCreateInfo, QueryPool, "query");
+create_device_resource!(create_set_layout, DescriptorSetLayoutCreateInfo, DescriptorSetLayout, "set");
+create_device_resource!(create_pipeline_layout, PipelineLayoutCreateInfo, PipelineLayout, "layout");
+create_device_resource!(create_command_pool, CommandPoolCreateInfo, CommandPool, "command");
+create_device_resource!(create_fence, FenceCreateInfo, Fence, "fence");
+create_device_resource!(create_descriptor_pool, DescriptorPoolCreateInfo, DescriptorPool, "descriptor");
+create_device_resource!(create_buffer, BufferCreateInfo, Buffer, "buffer");
+create_device_resource!(allocate_memory, MemoryAllocateInfo, DeviceMemory, "memory");
+create_device_resource!(create_shader_module, ShaderModuleCreateInfo, ShaderModule, "shader");
+destroy_device_resource!(destroy_query_pool, QueryPool, "query");
+destroy_device_resource!(destroy_set_layout, DescriptorSetLayout, "set");
+destroy_device_resource!(destroy_pipeline_layout, PipelineLayout, "layout");
+destroy_device_resource!(destroy_command_pool, CommandPool, "command");
+destroy_device_resource!(destroy_fence, Fence, "fence");
+destroy_device_resource!(destroy_descriptor_pool, DescriptorPool, "descriptor");
+destroy_device_resource!(destroy_buffer, Buffer, "buffer");
+destroy_device_resource!(free_memory, DeviceMemory, "memory");
+destroy_device_resource!(destroy_shader_module, ShaderModule, "shader");
+destroy_device_resource!(destroy_pipeline, Pipeline, "pipeline");
+
+unsafe extern "system" fn create_instance(
+    _: *const vk::InstanceCreateInfo<'_>, _: *const vk::AllocationCallbacks<'_>,
+    out: *mut vk::Instance,
+) -> vk::Result {
+    let result = checkpoint();
+    if result == vk::Result::SUCCESS {
+        unsafe { *out = vk::Instance::from_raw(created("instance")); }
+    }
+    result
+}
+
+unsafe extern "system" fn destroy_instance(
+    instance: vk::Instance, _: *const vk::AllocationCallbacks<'_>,
+) {
+    destroyed("instance", instance.as_raw());
+}
+
+unsafe extern "system" fn enumerate_devices(
+    _: vk::Instance, count: *mut u32, out: *mut vk::PhysicalDevice,
+) -> vk::Result {
+    let result = checkpoint();
+    if result == vk::Result::SUCCESS {
+        unsafe {
+            *count = if DRIVER.with(|d| d.borrow().no_devices) { 0 } else { 1 };
+            if !out.is_null() && *count != 0 { *out = vk::PhysicalDevice::from_raw(1); }
+        }
+    }
+    result
+}
+
+unsafe extern "system" fn get_properties(
+    _: vk::PhysicalDevice, out: *mut vk::PhysicalDeviceProperties,
+) {
+    unsafe {
+        *out = vk::PhysicalDeviceProperties::default();
+        (*out).device_type = vk::PhysicalDeviceType::DISCRETE_GPU;
+        (*out).limits.timestamp_period = 1.0;
+    }
+}
+
+unsafe extern "system" fn get_queue_properties(
+    _: vk::PhysicalDevice, count: *mut u32, out: *mut vk::QueueFamilyProperties,
+) {
+    unsafe {
+        *count = 1;
+        if !out.is_null() {
+            *out = vk::QueueFamilyProperties::default();
+            (*out).timestamp_valid_bits = 64;
+            (*out).queue_count = 1;
+            if !DRIVER.with(|d| d.borrow().no_compute) {
+                (*out).queue_flags = vk::QueueFlags::COMPUTE;
+            }
+        }
+    }
+}
+
+unsafe extern "system" fn get_features(_: vk::PhysicalDevice, _: *mut vk::PhysicalDeviceFeatures2<'_>) {}
+
+unsafe extern "system" fn enumerate_extensions(
+    _: vk::PhysicalDevice, _: *const c_char, count: *mut u32, _: *mut vk::ExtensionProperties,
+) -> vk::Result {
+    unsafe { *count = 0; }
+    vk::Result::SUCCESS
+}
+
+unsafe extern "system" fn create_device(
+    _: vk::PhysicalDevice, _: *const vk::DeviceCreateInfo<'_>,
+    _: *const vk::AllocationCallbacks<'_>, out: *mut vk::Device,
+) -> vk::Result {
+    let result = checkpoint();
+    if result == vk::Result::SUCCESS {
+        unsafe { *out = vk::Device::from_raw(created("device")); }
+    }
+    result
+}
+
+unsafe extern "system" fn destroy_device(device: vk::Device, _: *const vk::AllocationCallbacks<'_>) {
+    destroyed("device", device.as_raw());
+}
+
+unsafe extern "system" fn get_queue(_: vk::Device, _: u32, _: u32, out: *mut vk::Queue) {
+    unsafe { *out = vk::Queue::from_raw(1); }
+}
+
+unsafe extern "system" fn get_memory_properties(
+    _: vk::PhysicalDevice, out: *mut vk::PhysicalDeviceMemoryProperties,
+) {
+    unsafe {
+        *out = vk::PhysicalDeviceMemoryProperties::default();
+        (*out).memory_type_count = 1;
+        (*out).memory_types[0].property_flags = vk::MemoryPropertyFlags::DEVICE_LOCAL
+            | vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT;
+    }
+}
+
+unsafe extern "system" fn allocate_command_buffers(
+    _: vk::Device, _: *const vk::CommandBufferAllocateInfo<'_>, out: *mut vk::CommandBuffer,
+) -> vk::Result {
+    let result = checkpoint();
+    // Command buffers are owned/freed by their command pool.
+    if result == vk::Result::SUCCESS {
+        unsafe { *out = vk::CommandBuffer::from_raw(1); }
+    }
+    result
+}
+
+unsafe extern "system" fn wait_idle(_: vk::Device) -> vk::Result { vk::Result::SUCCESS }
+
+unsafe extern "system" fn get_buffer_requirements(
+    _: vk::Device, _: vk::Buffer, out: *mut vk::MemoryRequirements,
+) {
+    unsafe {
+        *out = vk::MemoryRequirements { size: 256, alignment: 1,
+            memory_type_bits: if DRIVER.with(|d| d.borrow().no_memory) { 0 } else { 1 } };
+    }
+}
+
+unsafe extern "system" fn bind_buffer_memory(
+    _: vk::Device, _: vk::Buffer, _: vk::DeviceMemory, _: vk::DeviceSize,
+) -> vk::Result { checkpoint() }
+
+unsafe extern "system" fn map_memory(
+    _: vk::Device, _: vk::DeviceMemory, _: vk::DeviceSize, _: vk::DeviceSize,
+    _: vk::MemoryMapFlags, out: *mut *mut c_void,
+) -> vk::Result {
+    let result = checkpoint();
+    if result == vk::Result::SUCCESS {
+        // Tests never dereference this mapped pointer.
+        unsafe { *out = std::ptr::NonNull::<u8>::dangling().as_ptr().cast(); }
+    }
+    result
+}
+
+unsafe extern "system" fn create_compute_pipelines(
+    _: vk::Device, _: vk::PipelineCache, count: u32,
+    _: *const vk::ComputePipelineCreateInfo<'_>, _: *const vk::AllocationCallbacks<'_>,
+    out: *mut vk::Pipeline,
+) -> vk::Result {
+    let result = checkpoint();
+    for i in 0..count as usize {
+        let handle = if result == vk::Result::SUCCESS || DRIVER.with(|d| d.borrow().partial_pipeline) {
+            vk::Pipeline::from_raw(created("pipeline"))
+        } else {
+            vk::Pipeline::null()
+        };
+        unsafe { *out.add(i) = handle; }
+    }
+    result
+}
+
+unsafe extern "system" fn get_device_proc_addr(_: vk::Device, name: *const c_char) -> vk::PFN_vkVoidFunction {
+    unsafe { get_instance_proc_addr(vk::Instance::null(), name) }
+}
+
+unsafe extern "system" fn get_instance_proc_addr(_: vk::Instance, name: *const c_char) -> vk::PFN_vkVoidFunction {
+    let name = unsafe { CStr::from_ptr(name) }.to_bytes();
+    let function = match name {
+        b"vkCreateInstance" => create_instance as *const (),
+        b"vkDestroyInstance" => destroy_instance as *const (),
+        b"vkEnumeratePhysicalDevices" => enumerate_devices as *const (),
+        b"vkGetPhysicalDeviceProperties" => get_properties as *const (),
+        b"vkGetPhysicalDeviceQueueFamilyProperties" => get_queue_properties as *const (),
+        b"vkGetPhysicalDeviceFeatures2" => get_features as *const (),
+        b"vkEnumerateDeviceExtensionProperties" => enumerate_extensions as *const (),
+        b"vkCreateDevice" => create_device as *const (),
+        b"vkDestroyDevice" => destroy_device as *const (),
+        b"vkGetDeviceProcAddr" => get_device_proc_addr as *const (),
+        b"vkGetDeviceQueue" => get_queue as *const (),
+        b"vkGetPhysicalDeviceMemoryProperties" => get_memory_properties as *const (),
+        b"vkCreateQueryPool" => create_query_pool as *const (),
+        b"vkDestroyQueryPool" => destroy_query_pool as *const (),
+        b"vkCreateDescriptorSetLayout" => create_set_layout as *const (),
+        b"vkDestroyDescriptorSetLayout" => destroy_set_layout as *const (),
+        b"vkCreatePipelineLayout" => create_pipeline_layout as *const (),
+        b"vkDestroyPipelineLayout" => destroy_pipeline_layout as *const (),
+        b"vkCreateCommandPool" => create_command_pool as *const (),
+        b"vkDestroyCommandPool" => destroy_command_pool as *const (),
+        b"vkAllocateCommandBuffers" => allocate_command_buffers as *const (),
+        b"vkCreateFence" => create_fence as *const (),
+        b"vkDestroyFence" => destroy_fence as *const (),
+        b"vkCreateDescriptorPool" => create_descriptor_pool as *const (),
+        b"vkDestroyDescriptorPool" => destroy_descriptor_pool as *const (),
+        b"vkDeviceWaitIdle" => wait_idle as *const (),
+        b"vkCreateBuffer" => create_buffer as *const (),
+        b"vkDestroyBuffer" => destroy_buffer as *const (),
+        b"vkGetBufferMemoryRequirements" => get_buffer_requirements as *const (),
+        b"vkAllocateMemory" => allocate_memory as *const (),
+        b"vkFreeMemory" => free_memory as *const (),
+        b"vkBindBufferMemory" => bind_buffer_memory as *const (),
+        b"vkMapMemory" => map_memory as *const (),
+        b"vkCreateShaderModule" => create_shader_module as *const (),
+        b"vkDestroyShaderModule" => destroy_shader_module as *const (),
+        b"vkCreateComputePipelines" => create_compute_pipelines as *const (),
+        b"vkDestroyPipeline" => destroy_pipeline as *const (),
+        _ => return None,
+    };
+    unsafe { Some(std::mem::transmute::<*const (), unsafe extern "system" fn()>(function)) }
+}

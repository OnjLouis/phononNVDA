+/// Set the sampling temperature for subsequent requests. Negative and non-finite values fail.
+///
+/// # Safety
+/// `h` must be null or come from `ptts_new` or `ptts_new_vulkan`.
+#[cfg(not(target_vendor = "apple"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_set_temperature(h: *mut PttsHandle, temperature: f32) -> bool {
+    let Some(h) = (unsafe { h.as_mut() }) else { return false };
+    if !temperature.is_finite() || temperature < 0.0 {
+        h.last_error = Some(c_string("Sampling temperature must be finite and nonnegative."));
+        return false;
+    }
+    h.engine.set_temperature(temperature);
+    true
+}
